generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updateAt  DateTime   @updatedAt @db.Timestamptz(3)
  RoleMenu  RoleMenu[]
  SOP       SOP[]
  Users     Users[]
}

model Menu {
  id        Int        @id @default(autoincrement())
  title     String     @unique
  seq       Int
  path      String
  icon      String?
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updateAt  DateTime   @updatedAt @db.Timestamptz(3)
  RoleMenu  RoleMenu[]
}

model RoleMenu {
  id        Int      @id @default(autoincrement())
  roleId    Int
  menuId    Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updateAt  DateTime @updatedAt @db.Timestamptz(3)
  menu      Menu     @relation(fields: [menuId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
}

model UserCoop {
  id        Int      @id @default(autoincrement())
  userId    Int
  coopId    Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updateAt  DateTime @updatedAt @db.Timestamptz(3)
  coop      Coop     @relation(fields: [coopId], references: [id])
  user      Users    @relation(fields: [userId], references: [id])

  @@unique([userId, coopId]) // tambahin ini
}

model Users {
  id              Int               @id @default(autoincrement())
  nik             String            @unique
  password        String
  name            String
  roleId          Int
  email           String?
  phone           String?
  avatar          String?
  is_active       Boolean           @default(true)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updateAt        DateTime          @updatedAt @db.Timestamptz(3)
  Cashflows       Cashflow[]
  CoopDiagnostics CoopDiagnostics[]
  FeedsMedicines  FeedsMedicines[]
  Notification    Notification[]
  ProgressSOP     ProgressSOP[]
  UserCoop        UserCoop[]
  role            Role              @relation(fields: [roleId], references: [id])
}

model Coop {
  id              Int               @id @default(autoincrement())
  name            String
  nik             String            @unique
  address         String
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updateAt        DateTime          @updatedAt @db.Timestamptz(3)
  isActive        Boolean           @default(true)
  CoopDiagnostics CoopDiagnostics[]
  EggProduction   EggProduction[]
  FeedsMedicines  FeedsMedicines[]
  ProgressSOP     ProgressSOP[]
  Report          Report[]
  ReportTemp      ReportTemp[]
  UserCoop        UserCoop[]
}

model Cashflow {
  id         Int      @id @default(autoincrement())
  periode    DateTime @db.Date
  userId     Int
  trans_date DateTime @db.Timestamptz(3)
  tipe       String
  nominal    Int
  total      Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updateAt   DateTime @updatedAt @db.Timestamptz(3)
  user       Users    @relation(fields: [userId], references: [id])
}

model SOP {
  id            Int      @id @default(autoincrement())
  roleId        Int
  title         String
  time          String
  isReduceStock Boolean  @default(false)
  description   String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updateAt      DateTime @updatedAt @db.Timestamptz(3)
  role          Role     @relation(fields: [roleId], references: [id])
}

model ProgressSOP {
  id        Int      @id @default(autoincrement())
  userId    Int
  coopId    Int
  detail    Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updateAt  DateTime @updatedAt @db.Timestamptz(3)
  coop      Coop     @relation(fields: [coopId], references: [id])
  user      Users    @relation(fields: [userId], references: [id])
}

model FeedsMedicines {
  id                    Int                     @id @default(autoincrement())
  SKU                   String                  @unique
  coopId                Int
  name                  String
  userId                Int
  quantity              Int
  uom                   String?
  price                 Int
  total                 Int
  isEatable             Boolean                 @default(false)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updateAt              DateTime                @updatedAt @db.Timestamptz(3)
  isActive              Boolean                 @default(true)
  coop                  Coop                    @relation(fields: [coopId], references: [id])
  user                  Users                   @relation(fields: [userId], references: [id])
  HistoryFeedsMedicines HistoryFeedsMedicines[]
}

model HistoryFeedsMedicines {
  id                Int             @id @default(autoincrement())
  feedId            Int
  coopDiagnosticsId Int?
  quantity          Int
  coopId            Int?
  userId            Int?
  tipe              String
  transDate         DateTime
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updateAt          DateTime        @updatedAt @db.Timestamptz(3)
  // coopDiagnostics   CoopDiagnostics @relation(fields: [coopDiagnosticsId], references: [id])
  feed              FeedsMedicines  @relation(fields: [feedId], references: [id])
}

model EggProduction {
  id              Int      @id @default(autoincrement())
  coopId          Int
  transDate       DateTime @db.Timestamptz(3)
  ageInDay        Int?
  ageInWeek       Int?
  pop             Int?
  m               Int?
  afk             Int?
  sell            Int?
  finalPop        Int?
  feedType        String?
  feedWeight      Int?
  feedFIT         Decimal?
  prodPieceN      Int?
  prodPieceP      Int?
  prodPieceBS     Int?
  prodTotalPiece  Int?
  prodWeightN     Decimal?
  prodWeightP     Decimal?
  prodWeightBS    Decimal?
  prodTotalWeight Decimal?
  HD              Decimal?
  FCR             Decimal?
  EggWeight       Decimal?
  EggMass         Decimal?
  OVK             String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updateAt        DateTime @updatedAt @db.Timestamptz(3)
  coop            Coop     @relation(fields: [coopId], references: [id])
}

model EggProductionTemp {
  id              Int      @id @default(autoincrement())
  isDuplicate     Boolean
  code            String
  coopId          Int
  transDate       DateTime @db.Timestamptz(3)
  ageInDay        Int?
  ageInWeek       Int?
  pop             Int?
  m               Int?
  afk             Int?
  sell            Int?
  finalPop        Int?
  feedType        String?
  feedWeight      Int?
  feedFIT         Decimal?
  prodPieceN      Int?
  prodPieceP      Int?
  prodPieceBS     Int?
  prodTotalPiece  Int?
  prodWeightN     Decimal?
  prodWeightP     Decimal?
  prodWeightBS    Decimal?
  prodTotalWeight Decimal?
  HD              Decimal?
  FCR             Decimal?
  EggWeight       Decimal?
  EggMass         Decimal?
  OVK             String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updateAt        DateTime @updatedAt @db.Timestamptz(3)
}

model CoopDiagnostics {
  id                    Int                     @id @default(autoincrement())
  coopId                Int
  transDate             DateTime                @db.Timestamptz(3)
  disease               String
  medicineId            Int?
  dose                  Int?
  status                String?
  reporterId            Int
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updateAt              DateTime                @updatedAt @db.Timestamptz(3)
  coop                  Coop                    @relation(fields: [coopId], references: [id])
  reporter              Users                   @relation(fields: [reporterId], references: [id])
  Notification          Notification[]
}

model Notification {
  id           Int             @id @default(autoincrement())
  message      String
  isRead       Boolean         @default(false)
  reporter     String
  listenerId   Int
  diagnosticId Int
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  diagnostic   CoopDiagnostics @relation(fields: [diagnosticId], references: [id])
  listener     Users           @relation(fields: [listenerId], references: [id])
}

model Report {
  id            Int      @id @default(autoincrement())
  coopId        Int
  transDate     DateTime @db.Timestamptz(3)
  jenis         String?
  qty           Int?
  indexs        Int?
  totalIncome   Int?
  eggNotes      Int?
  kilo          Int?
  price         Int?
  totalExpenses Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  coop          Coop     @relation(fields: [coopId], references: [id])
}

model ReportTemp {
  id            Int      @id @default(autoincrement())
  isDuplicate   Boolean
  coopId        Int
  transDate     DateTime @db.Timestamptz(3)
  jenis         String?
  qty           Int?
  indexs        Int?
  totalIncome   Int?
  eggNotes      Int?
  kilo          Int?
  price         Int?
  totalExpenses Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  coop          Coop     @relation(fields: [coopId], references: [id])
}
